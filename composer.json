{
    "name": "nintis/request-log-analyzer",
    "description": "A Laravel package for logging and analyzing HTTP requests.",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nazmul Islam Naim",
            "email": "nazmulislam.bdb@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "maatwebsite/excel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "NIN\\RequestLogAnalyzer\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "NIN\\RequestLogAnalyzer\\RequestLogAnalyzerServiceProvider"
            ],
            "aliases": {
                "RequestLogAnalyzer": "NIN\\RequestLogAnalyzer\\Facades\\RequestLogAnalyzer"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
